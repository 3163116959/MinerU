# syntax=docker/dockerfile:1

# GPU 版：镜像自带 CUDA torch + vllm，
# engine_utils._select_linux_engine() 会自动选中 vllm-engine。
# 沿用你已验证可拉取的镜像 tag。
ARG BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.21.0
ARG PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# ========== deps：系统依赖 + 外部 Python 依赖，只由 pyproject.toml 决定 ==========
FROM ${BASE_IMAGE} AS deps
ARG PIP_INDEX
ARG APT_MIRROR
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=${PIP_INDEX} \
    PIP_INDEX_URL=${PIP_INDEX} \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# apt 换国内源：只替换主机名，仓库路径（/ubuntu、/ubuntu-ports）原样保留，
# 故 amd64 与 arm64 通用。用 http：apt 靠 GPG 验签，不依赖 TLS。
# 海外构建传 --build-arg APT_MIRROR= 留空即跳过。
RUN if [ -n "${APT_MIRROR}" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
            if [ -f "$f" ]; then \
                sed -i "s|https\?://archive.ubuntu.com|http://${APT_MIRROR}|g; \
                        s|https\?://security.ubuntu.com|http://${APT_MIRROR}|g; \
                        s|https\?://ports.ubuntu.com|http://${APT_MIRROR}|g" "$f"; \
            fi; \
        done; \
    fi

# 系统依赖：opencv 需要 libgl1 + libglib2.0-0，CJK 渲染需要 noto 字体
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 && \
    fc-cache -f && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN pip install uv --break-system-packages

WORKDIR /src
# 只复制依赖清单 → 改业务代码不动这层（这层含 CUDA 生态，最贵）
COPY pyproject.toml ./
# -r pyproject.toml 只读依赖表，不构建项目，等价于 uv sync --no-install-project。
# 不带 [vllm]：镜像内 vllm/torch 已满足版本约束，uv 不会重装 → 保住 CUDA 绑定。
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --break-system-packages -r pyproject.toml --extra core

# ========== weights：烤入官方权重，与业务代码无依赖关系 ==========
# 挂在 deps 上而非 build 上：只复制下载器的 import 闭包（7 个文件），
# 改业务代码这层结构上就不会失效。上游给这些模块加新 import → 这里直接 ImportError，
# 不静默降级。cache mount 只兜住依赖清单变动这类少数场景。
# 缓存路径与运行时路径同为 /opt/models → mineru.json 记录的绝对路径无需改写。
FROM deps AS weights
COPY mineru/__init__.py ./mineru/
COPY mineru/utils/__init__.py \
     mineru/utils/enum_class.py \
     mineru/utils/models_download_utils.py \
     mineru/utils/config_reader.py \
     ./mineru/utils/
COPY mineru/cli/__init__.py mineru/cli/models_download.py ./mineru/cli/
ENV PYTHONPATH=/src \
    MODELSCOPE_CACHE=/opt/models \
    MINERU_TOOLS_CONFIG_JSON=/opt/models/mineru.json
# rm mineru.json：MinerU 的"配置里有路径且目录存在就跳过下载"是目录级判断
# （models_download_utils.py:151），断点续传留下的半截文件会被当成下载完成。
# 删掉配置 → 每次都交给 modelscope 自己校验补齐。
# 再用 .incomplete 断言兜底：宁可构建失败，也不把残缺权重烤进镜像。
RUN --mount=type=cache,target=/opt/models,id=mineru-models,sharing=locked \
    rm -f /opt/models/mineru.json \
    && python3 -m mineru.cli.models_download -s modelscope -m all \
    && ! find /opt/models -name '*.incomplete' | grep -q . \
    && cp -a /opt/models /opt/models-export

# ========== build：项目打成 wheel，装到 site-packages 之外的 /opt/app ==========
FROM deps AS build
COPY . /src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel --out-dir /src/dist \
    && uv pip install --python "$(command -v python3)" --no-deps --target /opt/app /src/dist/*.whl

# ========== runtime ==========
FROM deps

# 两条 COPY = 两层：权重 / 业务代码，依赖层直接复用 deps，改代码只重传几 MB
COPY --from=weights /opt/models-export /opt/models
COPY --from=build /opt/app /opt/app

ENV PATH="/opt/app/bin:$PATH" \
    PYTHONPATH=/opt/app \
    MINERU_TOOLS_CONFIG_JSON=/opt/models/mineru.json \
    MINERU_MODEL_SOURCE=local \
    MINERU_DEVICE_MODE=cuda \
    OMP_NUM_THREADS=1

WORKDIR /app
EXPOSE 8000

# 覆盖基础镜像的 `vllm serve` 入口
ENTRYPOINT ["/bin/bash", "-c", "exec \"$@\"", "--"]
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
