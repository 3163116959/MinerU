# syntax=docker/dockerfile:1

# GPU 版：镜像自带 CUDA torch + vllm，
# engine_utils._select_linux_engine() 会自动选中 vllm-engine。
# 锁 digest 而非只锁 tag：tag 被上游重推时会让全阶段缓存失效，
# 升级时手动换 digest（docker buildx imagetools inspect <tag> 取 Digest）。
# 选 v0.11.0：whisperx 锁死 torch~=2.8.0，而 vllm 0.11.0 正是自带 torch 2.8.0 的最后一版；
# 更高版本带 torch 2.9+，装 whisperx 时会被 uv 降级 torch → vllm 的 CUDA 扩展 ABI 失配。
ARG BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.11.0@sha256:014a95f21c9edf6abe0aea6b07353f96baa4ec291c427bb1176dc7c93a85845c
ARG PIP_INDEX=https://repo.huaweicloud.com/repository/pypi/simple
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# 基础镜像是 Ubuntu 22.04（vllm 官方镜像固定），发行版只给到 LibreOffice 7.3.7。
# 改装 TDF 官方 .deb 与发行版解耦：vllm 一行不动，LO 拿最新稳定版。
ARG LIBREOFFICE_VERSION=26.2.5
ARG LIBREOFFICE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/libreoffice

# ========== system：apt 源 + 系统库 + LibreOffice，位于 Python 依赖层之下 ==========
# 必须在 deps 之前：runtime 是 deps 的后代，若 LibreOffice 装在 deps 之上，
# 改一次 pyproject.toml 就会连带重建这 ~739MB 的 LO 层。
FROM ${BASE_IMAGE} AS system
ARG APT_MIRROR
ENV PYTHONUNBUFFERED=1

# apt 换国内源：只替换主机名，仓库路径（/ubuntu、/ubuntu-ports）原样保留，
# 故 amd64 与 arm64 通用。用 http：apt 靠 GPG 验签，不依赖 TLS。
# 海外构建传 --build-arg APT_MIRROR= 留空即跳过。
RUN if [ -n "${APT_MIRROR}" ]; then \
        for f in /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources; do \
            if [ -f "$f" ]; then \
                sed -i "s|https\?://archive.ubuntu.com|http://${APT_MIRROR}|g; \
                        s|https\?://security.ubuntu.com|http://${APT_MIRROR}|g; \
                        s|https\?://ports.ubuntu.com|http://${APT_MIRROR}|g" "$f"; \
            fi; \
        done; \
    fi

# 前半是 MinerU 自身所需：opencv 要 libgl1 + libglib2.0-0，CJK 渲染要 noto 字体，
# whisperx 解码音频要 ffmpeg（基础镜像已带，显式列出 → 换基础镜像时不会悄悄丢失）；
# 后半是 LibreOffice 的运行时系统库 —— TDF 的 .deb 不声明依赖（dpkg -i 不做解析），
# 缺任何一个都表现为 soffice 启动即 "error while loading shared libraries"。
# 一段 apt 装完：拆成两段会各跑一次 apt-get update。
# apt 缓存挂载需先删 docker-clean，否则 apt 装完即清空缓存目录。
# 时区 UTC+8 一并在此固化。
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        ffmpeg \
        libgl1 \
        libglib2.0-0 \
        ca-certificates \
        curl \
        libcairo2 \
        libcups2 \
        libdbus-glib-1-2 \
        libfreetype6 \
        libnss3 \
        libsm6 \
        libx11-xcb1 \
        libxext6 \
        libxinerama1 \
        libxrandr2 \
        tzdata && \
    fc-cache -f && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

# LibreOffice：WMF/EMF 矢量图在非 Windows 上 Pillow 无渲染后端，
# office_image.rasterize_vector_image 调 soffice 转 PNG，缺它则退占位图。
# 装 TDF 上游 .deb（~739MB）而非 apt：见顶部 ARG 处的版本说明。
# 官方只构建 x86_64/aarch64，其余架构直接构建失败，而不是运行期静默退占位图。
# tarball 走 cache mount：重建不重复下这 197MB。
# 末尾 soffice --version 是构建期断言：库缺失/装配失败当场暴露，不把坏镜像发出去。
ARG LIBREOFFICE_VERSION
ARG LIBREOFFICE_MIRROR
RUN --mount=type=cache,target=/var/cache/libreoffice,sharing=locked \
    set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) lo_dir=x86_64; lo_arch=x86-64 ;; \
        arm64) lo_dir=aarch64; lo_arch=aarch64 ;; \
        *) echo "no upstream LibreOffice build for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    tarball_name="LibreOffice_${LIBREOFFICE_VERSION}_Linux_${lo_arch}_deb.tar.gz"; \
    tarball="/var/cache/libreoffice/${tarball_name}"; \
    [ -f "${tarball}" ] || curl -fsSL -o "${tarball}" \
        "${LIBREOFFICE_MIRROR}/libreoffice/stable/${LIBREOFFICE_VERSION}/deb/${lo_dir}/${tarball_name}"; \
    mkdir -p /tmp/lo; \
    tar xzf "${tarball}" -C /tmp/lo --strip-components=1; \
    dpkg -i /tmp/lo/DEBS/*.deb; \
    rm -rf /tmp/lo; \
    ln -sf "/opt/libreoffice${LIBREOFFICE_VERSION%.*}/program/soffice" /usr/local/bin/soffice; \
    soffice --version

# ========== downloader：只含模型下载器源码，供 models 阶段 bind 挂载 ==========
# 单独成段：models 层的缓存键只取决于这几个文件，改其它业务代码不会触发重下权重。
# 上游给这些模块加新 import → models 阶段直接 ImportError，不静默降级。
FROM scratch AS downloader
COPY mineru/__init__.py /src/mineru/
COPY mineru/utils/__init__.py \
     mineru/utils/enum_class.py \
     mineru/utils/models_download_utils.py \
     mineru/utils/config_reader.py \
     /src/mineru/utils/
COPY mineru/cli/__init__.py mineru/cli/models_download.py /src/mineru/cli/

# ========== models：权重直接下载进镜像层，紧贴系统层之上 ==========
# 权重几乎不变 → 放在依赖与业务代码之下，改 pyproject.toml / 代码都复用这层，
# 推送/拉取时也只在系统层或下载器变化时才重传这几 GB。
# 下载器依赖装进临时 --target 目录，同一 RUN 内删掉，不污染运行环境；
# HOME 指向临时目录 → modelscope 写到家目录的杂项随之一并清掉。
# 末尾 .incomplete 断言：宁可构建失败，也不把残缺权重烤进镜像。
FROM system AS models
ARG PIP_INDEX
RUN --mount=type=bind,from=downloader,source=/src,target=/opt/downloader \
    --mount=type=cache,target=/var/cache/pip \
    set -eux; \
    PIP_CACHE_DIR=/var/cache/pip python3 -m pip install --break-system-packages --index-url "${PIP_INDEX}" \
        --target /tmp/dl click loguru requests \
        huggingface-hub==0.36.2 modelscope==1.39.1; \
    HOME=/tmp/dlhome \
    PYTHONPATH=/tmp/dl:/opt/downloader \
    MODELSCOPE_CACHE=/opt/models \
    MINERU_AUDIO_MODELS_DIR=/opt/models/audio \
    MINERU_TOOLS_CONFIG_JSON=/opt/models/mineru.json \
        python3 -m mineru.cli.models_download -s modelscope -m all; \
    ! find /opt/models -name '*.incomplete' | grep -q .; \
    python3 -c 'import json, os; p="/opt/models/mineru.json"; c=json.load(open(p, encoding="utf-8")); m=c["models-dir"]; assert c["model-source"] == "modelscope"; assert all(os.path.isdir(m[k]) for k in ("pipeline", "vlm", "audio")), m'; \
    rm -rf /tmp/dl /tmp/dlhome

# ========== deps：外部 Python 依赖，只由 pyproject.toml 决定 ==========
# 挂在 models 上：改 pyproject.toml 只重建本层及以上，权重层不动。
FROM models AS deps
ARG PIP_INDEX
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_DEFAULT_INDEX=${PIP_INDEX} \
    PIP_INDEX_URL=${PIP_INDEX} \
    PIP_NO_CACHE_DIR=1

RUN pip install uv --break-system-packages

WORKDIR /src
# 只复制依赖清单 → 改业务代码不动这层（这层含 CUDA 生态，最贵）
COPY pyproject.toml ./
# -r pyproject.toml 只读依赖表，不构建项目，等价于 uv sync --no-install-project。
# 不带 [vllm]：镜像内 vllm/torch 已满足版本约束，uv 不会重装 → 保住 CUDA 绑定。
# whisperx 的 torch~=2.8.0 / torchaudio~=2.8.0 同样由基础镜像满足。
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git; \
    uv pip install --system --break-system-packages --no-sources -r pyproject.toml --extra core; \
    apt-get purge -y git; \
    apt-get autoremove -y

# ========== build：项目打成 wheel，装到 site-packages 之外的 /opt/app ==========
FROM deps AS build
COPY . /src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv build --wheel --out-dir /src/dist \
    && uv pip install --python "$(command -v python3)" --no-deps --target /opt/app /src/dist/*.whl

# ========== runtime ==========
# 从 deps 起（系统层 → 权重层 → 依赖层）：Python 包装在系统 site-packages，
# 无法像 CPU 版那样 COPY 一个 venv。这一阶段只剩一条 COPY，改代码只重传几 MB。
FROM deps

COPY --from=build /opt/app /opt/app

ENV PATH="/opt/app/bin:$PATH" \
    PYTHONPATH=/opt/app \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONIOENCODING=utf-8 \
    MINERU_TOOLS_CONFIG_JSON=/opt/models/mineru.json \
    PYANNOTE_METRICS_ENABLED=false \
    MINERU_MODEL_SOURCE=local \
    MINERU_DEVICE_MODE=cuda \
    OMP_NUM_THREADS=1

WORKDIR /app
EXPOSE 8000

# 覆盖基础镜像的 `vllm serve` 入口
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

ENTRYPOINT ["/bin/bash", "-c", "exec \"$@\"", "--"]
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
